{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nekofm",
  "compatibility_date": "2025-08-03",
  "main": "./src/index.ts",
  "assets": {
    "not_found_handling": "single-page-application"
  },
  "kv_namespaces": [
    {
      "binding": "NEKOFM_KV",
      "id": "nekofm_kv"
    }
  ]
}